<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rialo Prediction Game</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      background: #f8fafc;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      text-align: center;
    }
    .card {
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
      padding: 24px;
      width: 320px;
    }
    button {
      background: #0070f3;
      color: white;
      border: none;
      border-radius: 8px;
      padding: 10px 20px;
      margin: 8px;
      cursor: pointer;
    }
    p { color: #333; }
  </style>
</head>
<body>
  <div class="card">
    <h2>🎯 Rialo Prediction Game</h2>
    <p>Will Bitcoin's price go up today?</p>
    <button onclick="makePrediction('yes')">Yes 🚀</button>
    <button onclick="makePrediction('no')">No 📉</button>
    <p id="result"></p>
  </div>

  <script>
    let prediction = null;

    async function makePrediction(choice) {
      prediction = choice;
      document.getElementById('result').innerText = "Fetching live data...";
      await checkBitcoinPrice();
    }

    async function checkBitcoinPrice() {
      try {
        const res = await fetch('https://api.coingecko.com/api/v3/coins/bitcoin');
        const data = await res.json();
        const change = data.market_data.price_change_percentage_24h;
        let wentUp = change > 0;

        if ((wentUp && prediction === 'yes') || (!wentUp && prediction === 'no')) {
          document.getElementById('result').innerHTML = `✅ You won! Bitcoin changed ${change.toFixed(2)}% today.`;
        } else {
          document.getElementById('result').innerHTML = `❌ You lost! Bitcoin changed ${change.toFixed(2)}% today.`;
        }
      } catch (error) {
        document.getElementById('result').innerText = "Error fetching data.";
      }
    }
  </script>
</body>
</html>
